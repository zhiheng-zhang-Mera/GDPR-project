*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
Thesis/Final/main.pdf
tmp/pdfs/
tmp/
node_modules.pnpm-backup/

# private university-submission metadata and locally rendered private edition
