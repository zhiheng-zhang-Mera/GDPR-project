{
  "name": "privacy-lens",
  "main": "expo-router/entry",
  "version": "1.7.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:qa": "cd android && gradlew.bat :app:assembleDebug -PreactNativeArchitectures=x86_64 --no-daemon --console=plain",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:compliance": "tsc -p tsconfig.compliance-tests.json && node .compliance-test-build/tests/runComplianceTests.js && node .compliance-test-build/tests/runExtendedComplianceTests.js && node .compliance-test-build/tests/runGovernanceAndPropertyTests.js",
    "test:accessibility": "node tests/runAccessibilityContractTests.js",
    "test:release-privacy": "node tests/runReleasePrivacyContractTests.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@react-native-community/cli-platform-android": "^20.1.3",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "postcss": "8.5.26"
  },
  "private": true
}
