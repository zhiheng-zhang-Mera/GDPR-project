{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Privacy Lens authorised Android-store corpus",
  "type": "object",
  "required": ["schema", "corpusId", "apps"],
  "properties": {
    "schema": {"const": "privacy-lens.android-store-corpus.v1"},
    "corpusId": {"type": "string", "minLength": 1},
    "apps": {
      "type": "array",
      "minItems": 100,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "displayName", "packageName", "storeUrl", "apkFiles"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "displayName": {"type": "string", "minLength": 1},
          "packageName": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "storeUrl": {"type": "string", "pattern": "^https://"},
          "apkFiles": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}}}
        }
      }
    }
  }
}
